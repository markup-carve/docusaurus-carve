    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "esbuild": "^0.25.0"
  },
  "peerDependencies": {"@docusaurus/core": ">=3.8.0 <4.0.0"}
