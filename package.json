{
  "name": "@markup-carve/docusaurus-carve",
  "version": "0.1.0",
  "description": "Docusaurus docs plugin for authoring pages in Carve markup",
  "license": "MIT",
  "author": "Mark Scherer",
  "keywords": ["docusaurus", "carve", "documentation", "markup"],
  "main": "dist/index.cjs",
